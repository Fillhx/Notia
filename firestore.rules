rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberData(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function hasCoordinatorRole(orgId) {
      return signedIn() && memberData(orgId).data.rol == 'Coordinación';
    }

    function belongsToOrganization(orgId) {
      return signedIn() && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    // Solo para miembros: rol Estudiante en esa organización (RN-06).
    function isStudent(orgId) {
      return memberData(orgId).data.rol == 'Estudiante';
    }

    // El estudiante autenticado está inscrito en la materia (campo studentIds de la materia).
    function isEnrolled(orgId, subjectId) {
      return request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)/subjects/$(subjectId)).data.studentIds;
    }

    // Búsqueda de "mis organizaciones" (RF-05): solo devuelve membresías propias.
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
    }

    // Códigos de invitación (RF-03, RF-04): se consulta por código exacto, no se lista.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['orgId', 'orgNombre'])
        && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.creadaPor == request.auth.uid;
    }

    match /organizations/{orgId} {
      allow read: if belongsToOrganization(orgId);
      allow create: if signedIn() && request.resource.data.creadaPor == request.auth.uid;
      allow update, delete: if hasCoordinatorRole(orgId);

      match /members/{uid} {
        allow read: if belongsToOrganization(orgId) || (signedIn() && request.auth.uid == uid);
        allow create: if hasCoordinatorRole(orgId)
          // Unirse con código: solo como Estudiante y con un código de esta organización (RF-04).
          || (signedIn()
              && request.auth.uid == uid
              && request.resource.data.uid == uid
              && request.resource.data.rol == 'Estudiante'
              && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.codigo)).data.orgId == orgId)
          // Creador de la organización: Coordinación, solo en el mismo guardado que crea la organización (RF-03).
          || (signedIn()
              && request.auth.uid == uid
              && request.resource.data.uid == uid
              && request.resource.data.rol == 'Coordinación'
              && !exists(/databases/$(database)/documents/organizations/$(orgId))
              && getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.creadaPor == request.auth.uid);
        allow update: if hasCoordinatorRole(orgId);
        allow delete: if hasCoordinatorRole(orgId) && uid != request.auth.uid;
      }

      match /periods/{periodId} {
        allow read: if belongsToOrganization(orgId);
        allow create, update: if hasCoordinatorRole(orgId);
        allow delete: if hasCoordinatorRole(orgId)
          && (!('subjectCount' in resource.data) || resource.data.subjectCount == 0);
      }

      match /subjects/{subjectId} {
        allow read: if belongsToOrganization(orgId);
        allow create, update: if hasCoordinatorRole(orgId);
        allow delete: if hasCoordinatorRole(orgId)
          && (!('gradesCount' in resource.data) || resource.data.gradesCount == 0);

        // Actividades: quien no es estudiante conserva el acceso de siempre; el estudiante solo lee
        // actividades publicadas de materias en las que está inscrito (RN-06, RNF-05).
        match /activities/{activityId} {
          allow read: if belongsToOrganization(orgId)
            && (!isStudent(orgId)
                || (resource.data.estado == 'publicada' && isEnrolled(orgId, subjectId)));
          allow write: if hasCoordinatorRole(orgId);
        }

        // Notas: el estudiante solo lee las suyas y publicadas (RN-06, RNF-04).
        // `estado` en la nota es copia del estado de la actividad; sin ese campo el estudiante no puede leerla.
        match /grades/{gradeId} {
          allow read: if belongsToOrganization(orgId)
            && (!isStudent(orgId)
                || (resource.data.studentId == request.auth.uid && resource.data.estado == 'publicada'));
          allow write: if hasCoordinatorRole(orgId);
        }

        // Historial: nunca visible para estudiantes.
        match /history/{historyId} {
          allow read: if belongsToOrganization(orgId) && !isStudent(orgId);
          allow create: if hasCoordinatorRole(orgId);
        }
      }

      // Avisos de notas (RF-18): el estudiante lee los suyos y solo puede cambiar el campo `read`.
      match /notices/{noticeId} {
        allow read: if signedIn()
          && belongsToOrganization(orgId)
          && resource.data.studentId == request.auth.uid;
        allow update: if signedIn()
          && belongsToOrganization(orgId)
          && resource.data.studentId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data['read'] is bool;
        allow create, delete: if hasCoordinatorRole(orgId);
      }
    }
  }
}
